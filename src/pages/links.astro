---
import QRCode from 'qrcode';
import { personal } from '../data/personal.js';
const url = new URL('/links', Astro.site).href;
const qr = await QRCode.toString(url, { type: 'svg', errorCorrectionLevel: 'M', margin: 4, width: 320, color: { dark: '#17241e', light: '#ffffff' } });
const qrDownload = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(qr);
const links = [
  { label: 'Explore my portfolio', detail: 'Projects, design & my story', href: '/', symbol: '↗', tone: 'yellow' },
  { label: 'GitHub', detail: '@rickyinnitdev · What I’m building', href: personal.socials.github, symbol: '{ }', tone: 'green' },
  { label: 'Telegram', detail: 'Let’s have a conversation', href: personal.socials.telegram, symbol: '↗', tone: 'blue' },
  { label: 'Facebook', detail: 'Find me on Facebook', href: personal.socials.facebook, symbol: 'f', tone: 'pink' },
  { label: 'Email me', detail: personal.email, href: 'mailto:' + personal.email, symbol: '@', tone: 'cream' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Links — Morm Kimheng</title>
    <meta name="description" content="Find Morm Kimheng’s portfolio, GitHub, Telegram, Facebook, and email in one place." />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" />
    <meta property="og:title" content="Morm Kimheng — Let’s connect" />
    <meta property="og:description" content="Designer, developer, and curious builder in Phnom Penh. All my links in one place." />
    <meta property="og:image" content={new URL('/images/34.JPG', Astro.site).href} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#eeebe3" />
  </head>
  <body>
    <main>
      <a class="wordmark" href="/" aria-label="Morm Kimheng portfolio">MK<span>.</span></a>
      <header>
        <div class="portrait"><img src="/images/34.JPG" alt="Morm Kimheng" width="120" height="120" /><span class="spark" aria-hidden="true">✳</span></div>
        <p class="eyebrow">PHNOM PENH, CAMBODIA</p>
        <h1>Morm Kimheng<span>.</span></h1>
        <p class="intro">Designer. Developer. Curious builder.<br />Making things that make everyday life easier.</p>
        <div class="tags"><span>WEB DEV</span><span>DESIGN</span><span>BUILDER</span></div>
      </header>
      <nav aria-label="Social and portfolio links">
        {links.map(link => <a class="link-card" href={link.href} target={link.href.startsWith('https:') ? '_blank' : undefined} rel={link.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>
          <span class:list={['icon', link.tone]} aria-hidden="true">{link.symbol}</span>
          <span class="link-text"><strong>{link.label}</strong><small>{link.detail}</small></span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>)}
      </nav>
      <section class="share" aria-labelledby="share-title">
        <div><p class="eyebrow">TAKE MY LINKS WITH YOU</p><h2 id="share-title">Scan. Save. Say hello.</h2><p>One QR code for all my links.</p></div>
        <div class="qr" set:html={qr}></div>
        <div class="share-actions"><button id="copy-link" type="button">Copy page link ↗</button><a href={qrDownload} download="kimheng-links-qr.svg">Download QR ↓</a></div>
        <p id="copy-status" role="status" aria-live="polite"></p>
        <a class="page-url" href={url}>kimheng.vercel.app/links</a>
      </section>
      <footer>Built out of curiosity. <a href="/">Explore my portfolio ↗</a></footer>
    </main>
    <script>
      document.querySelector('#copy-link')?.addEventListener('click', async () => {
        const status = document.querySelector('#copy-status');
        try {
          const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
          await navigator.clipboard.writeText(canonical?.href || location.href);
          if (status) status.textContent = 'Link copied!';
        } catch { if (status) status.textContent = 'Copy this address: kimheng.vercel.app/links'; }
      });
    </script>
    <style>
      :global(*) { box-sizing: border-box; }
      :global(body) { margin: 0; background: #eeebe3; color: #17241e; font-family: Arial, Helvetica, sans-serif; }
      :global(a) { color: inherit; }
      :global(:focus-visible) { outline: 3px solid #21684b; outline-offset: 5px; }
      main { max-width: 540px; margin: auto; padding: 28px 24px 32px; }
      .wordmark { font-size: 24px; font-weight: 900; letter-spacing: -2px; text-decoration: none; }
      .wordmark span, h1 span { color: #ae650d; }
      header { text-align: center; padding: 30px 0; }
      .portrait { width: 120px; height: 120px; position: relative; margin: 0 auto 25px; }
      .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: center 35%; border-radius: 50%; border: 5px solid #fffdf7; box-shadow: 0 5px 0 #d5d8cd; }
      .spark { position: absolute; bottom: -4px; right: -6px; background: #d2eeaa; border-radius: 50%; width: 40px; height: 40px; font-size: 32px; border: 3px solid #eeebe3; }
      .eyebrow { font-size: 10px; letter-spacing: 2px; font-weight: 700; color: #596459; }
      h1 { font-size: clamp(30px, 7vw, 40px); margin: 12px 0; letter-spacing: -1.7px; }
      .intro { font-size: 14px; line-height: 1.8; color: #526055; }
      .tags { display: flex; justify-content: center; gap: 7px; margin-top: 20px; }
      .tags span { border: 1px solid #c5cbbd; border-radius: 20px; padding: 6px 11px; font-size: 9px; letter-spacing: 1px; font-weight: 700; }
      nav { display: grid; gap: 12px; }
      .link-card { display: flex; align-items: center; gap: 15px; padding: 16px; border: 1px solid #c9d0c3; border-radius: 16px; text-decoration: none; background: #faf9f4; box-shadow: 0 3px 0 #d3d8cb; transition: transform .18s, box-shadow .18s; }
      .link-card:hover { transform: translateY(-3px); box-shadow: 0 6px 0 #c6cfbc; }
      .icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font-weight: 800; font-size: 20px; flex-shrink: 0; }
      .yellow { background: #f4df91; }.green { background: #d2eeaa; }.blue { background: #c7e0ec; }.pink { background: #f2cbd6; }.cream { background: #e9dfce; }
      .link-text { min-width: 0; }.link-text strong { display: block; font-size: 15px; }.link-text small { display: block; color: #5c675e; font-size: 11px; margin-top: 6px; overflow-wrap: anywhere; }
      .arrow { margin-left: auto; font-size: 22px; }
      .share { margin-top: 30px; border-radius: 20px; padding: 25px 20px; text-align: center; background: #dfe5d6; border: 1px solid #c9d0c3; }
      h2 { font-size: 23px; letter-spacing: -.8px; margin: 12px 0; }.share p:not(.eyebrow) { font-size: 12px; color: #526055; }
      .qr { margin: 18px auto; width: 174px; border-radius: 12px; overflow: hidden; background: white; }.qr :global(svg) { display: block; width: 100%; height: auto; }
      .share-actions { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }.share-actions a, button { font: inherit; font-size: 12px; border: 1px solid #b8c3b0; border-radius: 30px; background: #faf9f4; padding: 12px 15px; text-decoration: none; color: #17241e; cursor: pointer; }
      #copy-status { min-height: 15px; margin: 12px 0 0; }.page-url { font-size: 11px; text-underline-offset: 3px; }
      footer { text-align: center; font-size: 11px; color: #5c675e; margin-top: 28px; line-height: 2; } footer a { display: block; text-underline-offset: 3px; }
      @media (prefers-reduced-motion: reduce) { .link-card { transition: none; } }
    </style>
  </body>
</html>
